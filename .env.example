# Скопируй в .env и поправь под себя. Сам .env в git не попадает.

# Внутри docker compose Redis доступен по имени сервиса "redis".
# Для запуска backend/тестов на хосте — redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# Потолок на N для наивного фибоначчи. Подбирается замером duration_ms в логах.
MAX_FIBONACCI_N=35

# Правило ёмкости: реплики × WEB_CONCURRENCY × COMPUTE_POOL_SIZE ≈ число ядер.
WEB_CONCURRENCY=2
COMPUTE_POOL_SIZE=1

# Очередь ожидания в воркере: "считаются + ждут" ≤ BACKPRESSURE_FACTOR × COMPUTE_POOL_SIZE.
# Ждущий получит слот примерно через (factor - 1) × худшее вычисление — держи это
# меньше COMPUTE_QUEUE_WAIT_SECONDS. На медленной машине factor уменьшай.
BACKPRESSURE_FACTOR=8
COMPUTE_QUEUE_WAIT_SECONDS=10
